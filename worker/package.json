{
  "name": "nexusops-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute nexusops --local --file=src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute nexusops --remote --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute nexusops --local --file=src/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute nexusops --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^4.20250901.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
