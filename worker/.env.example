# Worker Environment Variables
# Set these in Cloudflare Dashboard → Workers → Settings → Variables

JWT_ACCESS_SECRET=your-random-32-char-secret-change-this-now
JWT_REFRESH_SECRET=another-random-32-char-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=https://nexusops.pages.dev
