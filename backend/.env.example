# Backend Environment Variables for Railway
# Copy these to Railway → Variables tab

DATABASE_URL=postgresql://postgres:password@host:5432/nexusops
JWT_ACCESS_SECRET=your-random-32-char-secret-here-change-this
JWT_REFRESH_SECRET=your-random-32-char-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-frontend.pages.dev
